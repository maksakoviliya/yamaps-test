# Переменные для docker-compose.prod.yml (только для интерполяции внутри
# самого compose-файла — сервис mysql). Скопировать в `.env` рядом с
# docker-compose.prod.yml и подставить эти же значения в backend/.env
# (DB_PASSWORD) при заполнении прод-окружения.
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-too
